# Maintainer: Yazeed Al Oyoun <me@yazeed.com>
pkgname=proc
_repo=proc-cli
pkgver=2.0.0
pkgrel=1
pkgdesc="Semantic CLI tool for process management. Target by port, PID, name or path."
arch=('x86_64' 'aarch64')
url="https://github.com/yazeed/proc-cli"
license=('MIT')
depends=('gcc-libs')
makedepends=('rust' 'cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/yazeed/proc-cli/archive/v$pkgver.tar.gz")
sha256sums=('a88b28e19be812447a3c850e27e5e502a10a0ae0492d04ea8a68ab94bd8020f5')

build() {
  cd "$_repo-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$_repo-$pkgver"
  install -Dm755 "target/release/proc" "$pkgdir/usr/bin/proc"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
