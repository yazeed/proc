# Maintainer: Yazeed Al Oyoun <me@yazeed.com>
pkgname=proc
_repo=proc-cli
pkgver=2.0.1
pkgrel=1
pkgdesc="Semantic CLI tool for process management. Target by port, PID, name or path."
arch=('x86_64' 'aarch64')
url="https://github.com/yazeed/proc-cli"
license=('MIT')
depends=('gcc-libs')
makedepends=('rust' 'cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/yazeed/proc-cli/archive/v$pkgver.tar.gz")
sha256sums=('3720b30d25c256a7b537c707bc75dc3ae3c92b8dc41eca5ad704a9e2a6f29691')

build() {
  cd "$_repo-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$_repo-$pkgver"
  install -Dm755 "target/release/proc" "$pkgdir/usr/bin/proc"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
